# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/

# Scratch and local logs
logs/
archive/
.results_download/
rerun_empty_gpt5.local.log
outputs/_cost_probe/

# Model weights and tensor caches. Regenerable from the trajectories, and large:
# the .pt embedding caches alone are ~38 GB across ~126k files.
*.pt
*.pth
*.safetensors
*.ckpt
*.bin
*.npy
*.npz
*.h5
*.onnx

# The probe caches that hold those tensors.
_sf-feats/
_sf-featsw/
_sf-ckpt/
_sf-pca/
_oat-states/
_oat-ckpt/

# Probe sweep output: per-trajectory embedding scores across seed replicas.
# These record no LLM calls, only classifier scores, and there are ~850k of them.
# Ignoring the per-dataset directories outright lets git skip the whole subtree;
# a file pattern like outputs-rb-*/**/*.json forces it to stat every one instead.
# Keep the reports/ TSVs the paper cites.
outputs-rb-*/*/*/
!outputs-rb-*/*/reports/

# vendored/StepFinder is a live clone with its own .git, so `git add` wants to
# record it as a gitlink rather than as files. Ignore rules cannot prevent that;
# removing its .git dir is what vendors it like CHIEF/OAT/CORRECT. Until then,
# skip it so `git add .` stays clean.
vendored/StepFinder/

# Scratch roots for timed re-runs (scripts/TODO.md); predictions there are never reported.
outputs-cost-gt/
outputs-cost-nogt/
